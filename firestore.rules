rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public telemetry collections
    match /sessions/{sessionId} {
      allow read, write: if true;
    }
    match /clicks/{clickId} {
      allow read, write: if true;
    }
    match /sectionViews/{viewId} {
      allow read, write: if true;
    }
  }
}
